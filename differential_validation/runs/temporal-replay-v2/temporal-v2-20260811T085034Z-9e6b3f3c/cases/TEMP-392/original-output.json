            "generated_grl": "\nrule TPR_de37d91d70df85a4_0 \"TPR-IR 1.0\" salience 100 {\nwhen\n\t(employee.Status == \"aktif\")\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"BONUS\", rates.Value(\"bonus_rate\"), 100, \"rule-version-3040\", 3040, 0);\n\tRetract(\"TPR_de37d91d70df85a4_0\");\n}\n\nrule TPR_de37da1d70df8757_0 \"TPR-IR 1.0\" salience 50 {\nwhen\n\t(attendance.LateMinutes > 0.0)\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"LATE_DEDUCTION\", (attendance.LateMinutes * rates.Value(\"late_rate\")), 50, \"rule-version-3041\", 3041, 1);\n\tRetract(\"TPR_de37da1d70df8757_0\");\n}\n",
