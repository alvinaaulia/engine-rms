            "generated_grl": "\nrule TPR_de2dcb1d70d71955_0 \"TPR-IR 1.0\" salience 100 {\nwhen\n\t(employee.Status == \"aktif\")\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"BONUS\", rates.Value(\"bonus_rate\"), 100, \"rule-version-3014\", 3014, 0);\n\tRetract(\"TPR_de2dcb1d70d71955_0\");\n}\n\nrule TPR_de2dca1d70d717a2_0 \"TPR-IR 1.0\" salience 50 {\nwhen\n\t(attendance.LateMinutes > 0.0)\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"LATE_DEDUCTION\", (attendance.LateMinutes * rates.Value(\"late_rate\")), 50, \"rule-version-3015\", 3015, 1);\n\tRetract(\"TPR_de2dca1d70d717a2_0\");\n}\n",
