            "generated_grl": "\nrule TPR_de34d91d70dd4fcd_0 \"TPR-IR 1.0\" salience 100 {\nwhen\n\t(employee.Status == \"aktif\")\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"BONUS\", rates.Value(\"bonus_rate\"), 100, \"rule-version-3036\", 3036, 0);\n\tRetract(\"TPR_de34d91d70dd4fcd_0\");\n}\n\nrule TPR_de34d81d70dd4e1a_0 \"TPR-IR 1.0\" salience 50 {\nwhen\n\t(attendance.LateMinutes > 0.0)\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"LATE_DEDUCTION\", (attendance.LateMinutes * rates.Value(\"late_rate\")), 50, \"rule-version-3037\", 3037, 1);\n\tRetract(\"TPR_de34d81d70dd4e1a_0\");\n}\n",
