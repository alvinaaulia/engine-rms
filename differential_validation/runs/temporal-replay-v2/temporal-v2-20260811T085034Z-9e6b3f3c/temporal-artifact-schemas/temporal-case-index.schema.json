{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temporal-case-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "run_id", "generated_at", "case_count", "cases"],
  "properties": {
    "artifact_version": {"const": "2.0"},
    "run_id": {"type": "string", "pattern": "^temporal-v2-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "category", "status", "artifact_path"], "properties": {"case_id": {"type": "string"}, "category": {"type": "string"}, "status": {"enum": ["MATCHED", "MISMATCHED", "EXPECTED_REJECTION", "FAIL"]}, "artifact_path": {"type": "string"}, "output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "request_id": {"type": ["string", "null"], "format": "uuid"}, "version_applicability": {"type": ["object", "null"]}, "mutation_wave": {"type": ["string", "null"]}}, "additionalProperties": false}}
  }
}
