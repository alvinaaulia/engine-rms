{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"mutation-wave.schema.json",
  "type":"array",
  "minItems":1,
  "items": {
    "oneOf": [
      {"type": "object", "additionalProperties": false,
        "required": ["wave_id", "baseline_state_sha256", "mutation", "mutation_parameters", "mutated_state_sha256", "baseline_current_execution", "mutated_current_execution", "historical_replay_result", "forbidden_query_count", "salary_side_effect_count", "result"],
        "properties": {
          "wave_id": {"type": "string", "pattern": "^I-WAVE-[0-9]{2}$"}, "baseline_state_sha256": {"$ref": "artifact-envelope.schema.json#/$defs/sha256"},
          "mutation": {"type": "string"}, "mutation_parameters": {"type": "object"}, "mutated_state_sha256": {"$ref": "artifact-envelope.schema.json#/$defs/sha256"},
          "baseline_current_execution": {"type": "object"}, "mutated_current_execution": {"type": "object"}, "historical_replay_result": {"type": "object"},
          "forbidden_query_count": {"const": 0}, "salary_side_effect_count": {"const": 0}, "result": {"enum": ["PASS", "FAIL"]}
        }
      },
      {"type": "object", "additionalProperties": false,
        "required": ["wave_id", "experiment", "mutation", "input_state_sha256", "mutated_state_sha256", "current_execution_before", "current_execution_after", "historical_replay_status", "historical_output_sha256", "forbidden_query_count", "inherits_previous_wave_state", "result"],
        "properties": {
          "wave_id": {"type": "string", "pattern": "^C-WAVE-[0-9]{2}$"}, "experiment": {"const": "CUMULATIVE_MUTATION_WAVES"}, "mutation": {"type": "string"},
          "input_state_sha256": {"$ref": "artifact-envelope.schema.json#/$defs/sha256"}, "mutated_state_sha256": {"$ref": "artifact-envelope.schema.json#/$defs/sha256"},
          "current_execution_before": {"type": "string"}, "current_execution_after": {"type": "string"}, "historical_replay_status": {"enum": ["MATCHED", "FAIL"]},
          "historical_output_sha256": {"$ref": "artifact-envelope.schema.json#/$defs/sha256"}, "forbidden_query_count": {"const": 0},
          "inherits_previous_wave_state": {"type": "boolean"}, "result": {"enum": ["PASS", "FAIL"]}
        }
      }
    ]
  }
}
