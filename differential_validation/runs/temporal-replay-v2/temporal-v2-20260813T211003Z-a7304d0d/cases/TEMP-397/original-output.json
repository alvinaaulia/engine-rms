            "generated_grl": "\nrule TPR_de31471d70da21e0_0 \"TPR-IR 1.0\" salience 100 {\nwhen\n\t(employee.Status == \"aktif\")\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"BONUS\", rates.Value(\"bonus_rate\"), 100, \"rule-version-3026\", 3026, 0);\n\tRetract(\"TPR_de31471d70da21e0_0\");\n}\n\nrule TPR_de31481d70da2393_0 \"TPR-IR 1.0\" salience 50 {\nwhen\n\t(attendance.LateMinutes > 0.0)\nthen\n\tout.Emit(\"ADD_COMPONENT\", \"LATE_DEDUCTION\", (attendance.LateMinutes * rates.Value(\"late_rate\")), 50, \"rule-version-3027\", 3027, 1);\n\tRetract(\"TPR_de31481d70da2393_0\");\n}\n",
