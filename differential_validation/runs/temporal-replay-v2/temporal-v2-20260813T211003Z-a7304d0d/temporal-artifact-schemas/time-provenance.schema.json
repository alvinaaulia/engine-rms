{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"time-provenance.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_version","run_id","started_at","finished_at","canonical_timezone","local_timezone"],
  "properties":{"artifact_version":{"const":"2.0"},"run_id":{"type":"string","pattern":"^temporal-v2-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"canonical_timezone":{"const":"UTC"},"local_timezone":{"type":"string","minLength":1}}
}
