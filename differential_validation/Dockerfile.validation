FROM python:3.14-bookworm@sha256:5dcba30b5f8fbd97e2f35dd1b140b3c94db70bd01b39ed88365732f8db8f68b5 AS python-runtime
FROM golang:1.26.2-bookworm@sha256:47ce5636e9936b2c5cbf708925578ef386b4f8872aec74a67bd13a627d242b19 AS go-runtime
FROM php:8.4-cli-bookworm@sha256:8f0c382c6483a202baaad042c9ad51064f050de1093e5e8db990d055dd18534f
RUN apt-get update && apt-get install -y --no-install-recommends $PHPIZE_DEPS make git unzip curl ca-certificates libonig-dev libxml2-dev libzip-dev && docker-php-ext-install pdo_mysql mbstring zip && rm -rf /var/lib/apt/lists/*
COPY --from=python-runtime /usr/local /usr/local
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=composer:2.8.10@sha256:20462d70afcfa999ad75dbd9333194067f4d869078bdb37430339e8d97e541d6 /usr/bin/composer /usr/local/bin/composer
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /artifact
CMD ["bash", "engine-rms/differential_validation/clean_validate.sh"]
