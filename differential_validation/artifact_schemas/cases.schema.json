{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "schema_version", "dataset_id", "random_seed", "profile_count", "period_count", "valid_case_count", "invalid_case_count", "case_count", "cases"],
  "properties": {
    "artifact_version": {"const": "2.0"},
    "schema_version": {"const": "2.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer"},
    "profile_count": {"type": "integer", "minimum": 1},
    "period_count": {"type": "integer", "minimum": 1},
    "valid_case_count": {"type": "integer", "minimum": 0},
    "invalid_case_count": {"type": "integer", "minimum": 0},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "profile_id", "period", "validity", "facts", "primary_category", "secondary_categories", "execution_route", "treatment", "treatment_parameters", "expected_behavior", "rationale"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^(PAY-[0-9]{3}-[0-9]{2}|INVALID-[0-9]{3})$"},
        "profile_id": {"type": "string", "minLength": 1},
        "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "validity": {"enum": ["VALID", "INVALID"]},
        "facts": {"type": "object"},
        "primary_category": {"enum": ["NORMAL_CASE", "BOUNDARY_CASE", "ROUNDING_SENSITIVE", "LEGACY_ADAPTER", "RULE_INTERACTION", "INVALID_INPUT", "EFFECTIVE_DATE", "ZERO_VALUE"]},
        "secondary_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "execution_route": {"enum": ["CANONICAL_TPR_IR", "LEGACY_ADAPTER"]},
        "treatment": {"type": "string", "minLength": 1},
        "treatment_parameters": {"type": "object"},
        "expected_behavior": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
        ,"expected_error_code": {"type": "string", "minLength": 1}
      }
    }
  }
}
