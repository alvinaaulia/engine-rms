{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-execution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_file", "stdout_file", "stderr_file", "parser_version", "command", "exit_code", "started_at", "finished_at", "duration_seconds"],
  "properties": {
    "evidence_file": {"type": "string", "minLength": 1},
    "stdout_file": {"type": "string", "minLength": 1},
    "stderr_file": {"type": "string", "minLength": 1},
    "parser_version": {"const": "2.0"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exit_code": {"type": "integer"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0}
  }
}

