{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e-trace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "schema_version", "case_count", "traces"],
  "properties": {
    "artifact_version": {"const": "2.0"},
    "schema_version": {"const": "2.0"},
    "case_count": {"type": "integer", "minimum": 1},
    "traces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trace"}}
  },
  "$defs": {"trace": {
    "type": "object",
    "additionalProperties": false,
    "required": ["case_id", "status", "evaluation_category", "secondary_categories", "execution_path", "database_fixture", "laravel_test", "service_method", "go_request_id", "go_request_correlation_status", "go_request_hash", "go_response_hash", "rule_version_ids", "component_codes", "persistence_asserted", "persisted_salary_id", "expected_hash", "actual_hash", "result"],
    "properties": {
      "case_id": {"type": "string", "pattern": "^E2E-[0-9]{3}$"},
      "status": {"enum": ["EXACT_MATCH", "EXPECTED_REJECTION", "RUNTIME_FAILURE", "MISMATCH"]},
      "evaluation_category": {"enum": ["FULL_PAYROLL_PIPELINE", "LARAVEL_CONFIGURATION_GUARD", "LARAVEL_TO_GO_INTEGRATION", "TRANSLATOR_FIXTURE", "PERSISTENCE_E2E"]},
      "secondary_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "configuration": {"type": "string"},
      "error": {"type": "object"},
      "execution_path": {"type": "array", "minItems": 3, "items": {"type": "string"}},
      "database_fixture": {"type": ["object", "string"]},
      "laravel_test": {"type": "string", "minLength": 1},
      "service_method": {"type": "string", "minLength": 1},
      "employee_fixture_id": {"type": ["string", "null"]},
      "laravel_service_method": {"type": "string", "minLength": 1},
      "go_request_id": {"type": ["string", "null"]},
      "go_request_correlation_status": {"enum": ["OBSERVED", "NOT_OBSERVABLE", "NOT_APPLICABLE_REJECTED_BEFORE_HTTP"]},
      "go_request_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
      "go_response_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
      "attendance_source": {"type": "string"},
      "rule_version_ids": {"type": "array", "items": {"type": "integer"}},
      "rate_version_ids": {"type": "array", "items": {"type": "integer"}},
      "tax_version_ids": {"type": "array", "items": {"type": "integer"}},
      "tax_version_status": {"type": "string"},
      "go_internal_path": {"type": "array", "items": {"type": "string"}},
      "go_internal_trace_status": {"type": "string"},
      "component_codes": {"type": "array", "items": {"type": "string"}},
      "persistence_asserted": {"type": "boolean"},
      "persisted_salary_id": {"type": ["integer", "null"]},
      "salary_record_id": {"type": ["integer", "null"]},
      "expected_error_codes": {"type": "array", "items": {"type": "string"}},
      "actual_error_codes": {"type": "array", "items": {"type": "string"}},
      "salary_count_before": {"type": "integer", "minimum": 0},
      "salary_count_after": {"type": "integer", "minimum": 0},
      "database_unchanged": {"type": "boolean"},
      "expected_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "actual_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "result": {"enum": ["PASS", "FAIL"]}
    }
  }}
}
