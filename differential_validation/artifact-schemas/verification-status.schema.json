{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "verification_status", "verification_method", "verifier_id", "verification_timestamp", "expected_hash", "policy_hash", "adjudication_reference", "notes"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^(PAY-[0-9]{3}-[0-9]{2}|INVALID-[0-9]{3})$"},
    "verification_status": {"enum": ["REFERENCE_GENERATED", "POLICY_DERIVED", "INDEPENDENTLY_VERIFIED", "DISPUTED", "ADJUDICATED", "EXCLUDED_WITH_REASON"]},
    "verification_method": {"type": "string", "minLength": 1},
    "verifier_id": {"type": ["string", "null"]},
    "verification_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "expected_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adjudication_reference": {"type": ["string", "null"]},
    "adjudicator": {"type": ["string", "null"]},
    "decision_date": {"type": ["string", "null"], "format": "date"},
    "written_rationale": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"verification_status": {"const": "ADJUDICATED"}}},
    "then": {"required": ["adjudicator", "decision_date", "written_rationale"], "properties": {"adjudication_reference": {"type": "string", "minLength": 1}, "adjudicator": {"type": "string", "minLength": 1}, "decision_date": {"type": "string"}, "written_rationale": {"type": "string", "minLength": 1}}}
  }]
}

