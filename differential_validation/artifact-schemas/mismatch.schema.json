{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "mismatch.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_version", "schema_version", "run_id", "case_count", "mismatch_count", "mismatched_case_count", "mismatches"],
  "properties": {
    "artifact_version": {"const": "2.0"}, "schema_version": {"const": "2.0"}, "run_id": {"type": "string"}, "case_count": {"type": "integer", "minimum": 1},
    "mismatch_count": {"type": "integer", "minimum": 0}, "mismatched_case_count": {"type": "integer", "minimum": 0},
    "mismatches": {"type": "array", "items": {"type": "object"}}
  }
}

