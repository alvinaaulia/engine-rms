{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "replay-result.schema.json",
  "allOf": [
    {"$ref": "artifact-envelope.schema.json"},
    {"properties": {"schema_ref": {"const": "temporal-artifact-schemas/replay-result.schema.json"}, "payload": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
          "required": ["repeat", "category", "status", "replay_uuid", "request_id", "laravel_correlation_id", "go_request_id", "translator_trace_id", "grule_execution_id", "output_sha256", "difference_count", "forbidden_lookup_count", "salary_side_effect_count", "comparator_result", "version_applicability", "stage_latencies_microseconds"],
          "properties": {
            "repeat": {"type": "integer", "minimum": 1}, "category": {"type": "string"}, "status": {"enum": ["MATCHED", "FAIL"]},
            "replay_uuid": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"}, "request_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"},
            "laravel_correlation_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"}, "go_request_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"},
            "translator_trace_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"}, "grule_execution_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"},
            "output_sha256": {"$ref": "artifact-envelope.schema.json#/$defs/sha256"}, "difference_count": {"type": "integer", "minimum": 0},
            "forbidden_lookup_count": {"type": "integer", "minimum": 0}, "salary_side_effect_count": {"type": "integer", "minimum": 0},
            "comparator_result": {"type": "object"}, "version_applicability": {"type": "object"},
            "stage_latencies_microseconds": {"type": "object", "additionalProperties": false, "required": ["manifest_validation", "replay_execution", "comparator", "total"], "properties": {
              "manifest_validation": {"type": "integer", "minimum": 0}, "replay_execution": {"type": "integer", "minimum": 0},
              "comparator": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}
            }}
          }
        },
        {"type": "object", "additionalProperties": false, "required": ["repeat", "category", "status", "preflight_correlation", "expected_error_code", "actual_error"], "properties": {
          "repeat": {"type": "integer", "minimum": 1}, "category": {"type": "string"}, "status": {"enum": ["EXPECTED_REJECTION", "FAIL"]},
          "preflight_correlation": {"type": "object", "additionalProperties": false, "required": ["replay_uuid", "request_id", "laravel_correlation_id", "stage"], "properties": {
            "replay_uuid": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"}, "request_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"},
            "laravel_correlation_id": {"$ref": "artifact-envelope.schema.json#/$defs/uuid"}, "stage": {"const": "LARAVEL_PREFLIGHT"}
          }},
          "expected_error_code": {"type": "string"}, "actual_error": {"type": "object"}
        }}
      ]
    }}}
  ]
}
